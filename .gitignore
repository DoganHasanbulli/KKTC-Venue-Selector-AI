# --- Proje verisi (ilk çalıştırmada otomatik oluşur) ---
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
!database/.gitkeep

# --- Yerel yapılandırma ve sırlar ---
.env
.env.*
!.env.example

# --- Editör / IDE ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace

# --- İşletim sistemi ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# --- Loglar ve geçici dosyalar ---
*.log
*.tmp
*.bak
*.swp
*~

# --- Araç / ajan artıkları ---
.abacus.donotdelete
